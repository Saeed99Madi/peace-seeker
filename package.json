{
  "name": "peace-seekers",
  "version": "0.1.0",
  "private": true,
  "description": "Peace Seekers — web platform for the Peace Everywhere Foundation",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @peace/shared && npm run build --workspace @peace/api && npm run build --workspace @peace/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @peace/api",
    "dev:web": "npm run dev --workspace @peace/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @peace/api",
    "db:seed": "npm run db:seed --workspace @peace/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
