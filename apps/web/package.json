{
  "name": "@peace/web",
  "version": "0.1.0",
  "private": true,
  "description": "Peace Seekers web client (Next.js App Router + MUI)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/check-messages.mjs && node scripts/check-seo.mjs && NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -p ${PORT:-3000}",
    "lint": "node scripts/check-messages.mjs && node scripts/check-seo.mjs && next lint",
    "typecheck": "tsc --noEmit",
    "photos:build": "node scripts/optimize-photos.mjs",
    "check:messages": "node scripts/check-messages.mjs",
    "test": "node scripts/check-messages.mjs && node scripts/check-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@peace/shared": "*",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "stylis": "^4.3.4",
    "stylis-plugin-rtl": "^2.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/stylis": "^4.2.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.7.3"
  }
}
