# The browser talks to the API directly; both are same-site in production so
# the session cookie can stay SameSite=Strict.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The one canonical origin. Everything else (a second domain, a hyphenated
# variant, www) must 301 here — two live domains split your search standing.
NEXT_PUBLIC_SITE_URL=https://peace-seekers.com
