# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://user:password@host:5432/peace_seekers?schema=public
REDIS_URL=redis://host:6379

WEB_ORIGIN=https://peaceseekers.org
API_PUBLIC_URL=https://api.peaceseekers.org

# How many proxies sit in front of this process (load balancer, ingress, CDN).
# Must be exact: too low and every visitor shares one address, so rate limiting
# becomes global; too high and a client can forge X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# --- Secrets ------------------------------------------------------------------
# Generate each separately:  openssl rand -base64 48
# They must differ from one another — reusing one means a leak of one is a leak
# of all, and lets an email hash be correlated with an address hash.
# Rotating a pepper invalidates every hash derived from it; hold them in a
# managed secret store, not in this file.
EMAIL_HASH_PEPPER=
IP_HASH_PEPPER=
SESSION_SECRET=

# --- Object storage (S3-compatible, EU residency — S-8) ------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=peace-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail (sign-in links, withdrawal links, case notifications) ----------------
# A provider with EU data residency (§11). TLS is enforced regardless of what
# the URL says, and the certificate must validate.
MAIL_TRANSPORT=smtp
MAIL_FROM="Peace Seekers <no-reply@peaceseekers.org>"
SMTP_URL=smtps://user:password@smtp.provider.eu:465

# --- Abuse mitigation ----------------------------------------------------------
# A-8: invisible only, never a visible puzzle, and never required for a Voice to
# be counted. Leave empty to rely on rate limiting alone.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Bucket in the hostname (AWS, Railway) or in the path (MinIO, most self-hosted).
S3_FORCE_PATH_STYLE=false
